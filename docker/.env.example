# Modified by the HeoPress project; based on LumiBase (Apache-2.0). See NOTICE.
# HeoPress Docker Environment Variables
# Copy this file to .env and adjust values for your environment.

# Runtime mode (docker or cloudflare)
HEOPRESS_RUNTIME=docker

# PostgreSQL connection
DATABASE_URL=postgresql://heopress:heopress_dev@postgres:5432/heopress
# Optional secret-file alternative. If DATABASE_URL is unset, Docker entrypoint
# reads the value from this file path before migrations/server startup.
DATABASE_URL_FILE=
# docker-compose.prod.yml defaults to sslmode=require (a managed database).
# The database container of the base compose file serves no TLS: set
# DATABASE_SSL_MODE=disable when the prod override runs against it.
DATABASE_SSL_MODE=
# Database password of the bundled PostgreSQL container.
POSTGRES_PASSWORD=heopress_dev

# Vector search (needs pgvector, included in the HeoPress database image).
HEOPRESS_VECTOR_SEARCH=false

# Media storage: `local` (default, the `storage` volume) or `s3`.
HEOPRESS_STORAGE=local
# S3-compatible storage — with `--profile s3` (SeaweedFS: S3_ENDPOINT=http://seaweedfs:8333,
# S3_FORCE_PATH_STYLE=true; SeaweedFS accepts only this key pair, so set both
# keys to long random values), or any S3 / OSS / COS bucket
# (docs/en/deployment/object-storage.md).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=

# Search runs on PostgreSQL unless MEILISEARCH_HOST is set
# (e.g. http://meilisearch:7700 with `--profile meilisearch`).
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Internal services reached as service connections, exact origins only,
# e.g. http://seaweedfs:8333,http://meilisearch:7700 (docs/en/security/outbound-requests.md).
HEOPRESS_TRUSTED_INTERNAL_ENDPOINTS=

# Crawl services (docs/zh-CN/content/crawl-services.md). The crawl4ai profile's own Crawl4AI is
# http://crawl4ai:11235 (the default; trusted for the Crawl4AI service only). Set empty to turn it off.
# HEOPRESS_CRAWL4AI_ENDPOINT=http://crawl4ai:11235
# Circuit breaker: failures in a row before a service is paused for a site, and for how long.
# HEOPRESS_INGEST_PROVIDER_BREAKER_FAILURES=5
# HEOPRESS_INGEST_PROVIDER_BREAKER_MINUTES=15

# CMS server port
PORT=1989

# ── AI Copilot / LLM provider ───────────────────────────────────────────────
# openai | anthropic | claude | gemini | nvidia | echo
# `echo` (default) is a no-LLM keyword matcher; set a real provider to enable
# natural-language Copilot actions.
LLM_PROVIDER=echo
# Optional provider-specific model override.
LLM_MODEL=
# OpenAI
OPENAI_API_KEY=
# Anthropic / Claude
ANTHROPIC_API_KEY=
# Google Gemini (public Generative Language API)
GEMINI_API_KEY=
# NVIDIA hosted inference (build.nvidia.com / NIM) — OpenAI-compatible.
# Billed by NVIDIA. Point NVIDIA_BASE_URL at a self-hosted NIM container
# (e.g. on an AWS GPU instance) to use your own deployment instead.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# ── Decision model (POST /api/ai/decisions) ─────────────────────────────────
# typesafe | openrouter | llm — unset disables the endpoint (503).
# `typesafe` calls TypeSafe Jev directly; `openrouter` calls the same System
# One API through OpenRouter (billed to OpenRouter); `llm` reuses LLM_PROVIDER
# above, with uncalibrated probabilities (`calibrated: false`).
DECISION_PROVIDER=
# Optional model override (default jev-latest, or ~typesafe/jev-latest on OpenRouter).
DECISION_MODEL=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
OPENROUTER_API_KEY=
# Bounds (empty = default): total deadline incl. retries, one attempt's
# timeout, retries after the first attempt, and the input budget on
# state + questions (UTF-8 bytes, and an estimated token count).
DECISION_TIMEOUT_MS=
DECISION_ATTEMPT_TIMEOUT_MS=
DECISION_MAX_RETRIES=
DECISION_MAX_INPUT_BYTES=
DECISION_MAX_INPUT_TOKENS=

# Pressure limiter (Node/Docker CMS overload protection)
# Returns HTTP 503 with Retry-After when the Node.js event loop is overloaded.
HEOPRESS_PRESSURE_LIMITER_ENABLED=true
HEOPRESS_PRESSURE_LIMITER_SAMPLE_INTERVAL=250
HEOPRESS_PRESSURE_LIMITER_MAX_EVENT_LOOP_DELAY=1000
# Set to a value such as 0.99 to also reject requests when event loop utilization is too high.
HEOPRESS_PRESSURE_LIMITER_MAX_EVENT_LOOP_UTILIZATION=false
HEOPRESS_PRESSURE_LIMITER_RETRY_AFTER=5
HEOPRESS_PRESSURE_LIMITER_EXCLUDED_PATHS=/health,/metrics

# Production TLS reverse proxy overlay (docker-compose.tls.yml)
PUBLIC_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Optional host port overrides for docker-compose.yml.
POSTGRES_PORT=5432
MINIO_CONSOLE_PORT=9001
CMS_PORT=1989

# Authentication (OIDC via Logto)
LOGTO_ISSUER=
LOGTO_AUDIENCE=
JWT_SECRET=
JWT_SECRET_FILE=

# Encryption key for sensitive data (base64-encoded AES-GCM key)
ENCRYPTION_KEY=
ENCRYPTION_KEY_FILE=

# Public sites (HeoPress P06): the rendering service connects as the read-only
# role heopress_render, which the CMS creates at startup with this password.
# Required in production (docker-compose.prod.yml has no default); both the
# password and the full connection string, or *_FILE variants (Docker secrets).
HEOPRESS_RENDER_PASSWORD=
HEOPRESS_RENDER_PASSWORD_FILE=
# postgresql://heopress_render:<password>@postgres:5432/heopress
HEOPRESS_RENDER_DATABASE_URL=
HEOPRESS_RENDER_DATABASE_URL_FILE=
# Set to true when the rendering role is provisioned outside the CMS container.
HEOPRESS_SKIP_RENDER_ROLE=false
# Previews (docs/zh-CN/rendering/preview.md): a dedicated origin, and a shared
# secret of 32+ characters between the CMS and the rendering service.
HEOPRESS_PREVIEW_ORIGIN=
HEOPRESS_INTERNAL_SECRET=
HEOPRESS_INTERNAL_SECRET_FILE=
HEOPRESS_PREVIEW_MEDIA_ORIGINS=

# Comma-separated frontend origins allowed by CORS.
# Example: https://studio.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Optional OpenTelemetry tracing (OTLP export to a collector you run yourself).
HEOPRESS_TRACING_ENABLED=false
HEOPRESS_TRACING_PROVIDER=otlp
HEOPRESS_SERVICE_NAME=heopress-cms
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
HEOPRESS_TRACING_SAMPLING_RATIO=1

# ── Optional features (off by default; set to true and restart) ────────────
# See docs/en/deployment/environment-variables.md#optional-features
# HEOPRESS_ENABLE_GRAPHQL=true
# HEOPRESS_ENABLE_AGENT_NEWSROOM=true
# HEOPRESS_ENABLE_CONTENT_GOALS=true
# HEOPRESS_ENABLE_EXTERNAL_ISSUERS=true
# HEOPRESS_ENABLE_LOGIN_ANOMALY=true
# HEOPRESS_ENABLE_METRICS=true
# HEOPRESS_ENABLE_FIELD_ENCRYPTION=true
