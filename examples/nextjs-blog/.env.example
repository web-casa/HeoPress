# Modified by the HeoPress project; based on LumiBase (Apache-2.0). See NOTICE.
# Base URL of the HeoPress CMS API
HEOPRESS_URL=http://127.0.0.1:1989

# Read-only API key from HeoPress Studio (Settings → API keys).
# Give it a role that can only READ the collections this site renders — never
# an admin token. Server-side only: no NEXT_PUBLIC_ prefix, so it stays out of
# the browser bundle.
HEOPRESS_TOKEN=lbk_xxxxxxxxxxxxxxxxxxxxxxxx

# Tenant (site) id. `__default__` unless you created more sites.
HEOPRESS_SITE_ID=__default__
