# Modified by the HeoPress project; based on LumiBase (Apache-2.0). See NOTICE.
# Base URL of the HeoPress API server
HEOPRESS_URL=http://127.0.0.1:1989

# Bearer token / API key from HeoPress Studio.
# IMPORTANT: use a PUBLIC-scoped token. NEVER use a token that holds the
# `read_decrypted` permission in a frontend — it would expose pii/phi.
HEOPRESS_TOKEN=your-public-heopress-token

# Active tenant Site ID
HEOPRESS_SITE_ID=your-site-id
