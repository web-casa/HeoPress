diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..24eabb82b84644edae072d12dffe42a183b7191a 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -440,6 +440,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    // HeoPress patch: bytes still buffered for the closed socket must not be sent ahead of the next session's startup
+    // message, and a cleared timer left in place would keep that message from ever being flushed.
+    nextWriteTimer = chunk = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
@@ -453,6 +456,10 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       return reconnect()
 
     !hadError && (query || sent.length) && error(Errors.connection('CONNECTION_CLOSED', options, socket))
+    // HeoPress patch: the query that was running, now rejected, and the error the server sent for it (e.g. FATAL
+    // 57P01 when PostgreSQL shuts down) belong to the closed session. Kept, the first ReadyForQuery of the next
+    // session took them as its own and failed the query that reconnected the connection with that stale error.
+    query = errorResponse = null
     closedTime = performance.now()
     hadError && options.shared.retries++
     delay = (typeof backoff === 'function' ? backoff(options.shared.retries) : backoff) * 1000
diff --git a/cf/src/index.js b/cf/src/index.js
index ffbe7aef075d6037c540cbd5e8f7e298d4345cc3..e18887330954a902b07f5d8be3a35b7d1a89e180 100644
--- a/cf/src/index.js
+++ b/cf/src/index.js
@@ -212,20 +212,36 @@ function Postgres(a, b) {
       })
 
     move(c, reserved)
-    c.reserved = () => queue.length
+    const reservation = c.reserved = () => queue.length
       ? c.execute(queue.shift())
       : move(c, reserved)
     c.reserved.release = true
+    // HeoPress patch: when the connection closes, onclose clears c.reserved and the pool takes the connection back
+    // (it may reconnect it at once for a waiting query). The reservation is then over: its queries are rejected and
+    // its release does nothing. Before, a query on it wrote to the socket that was gone (an uncaught TypeError in
+    // nextWrite) and release handed the closed connection back to the pool as open.
+    c.onclose = rejectQueued
 
     const sql = Sql(handler)
     sql.release = () => {
+      if (c.reserved !== reservation)
+        return
+      c.onclose === rejectQueued && (c.onclose = null)
       c.reserved = null
       onopen(c)
     }
 
     return sql
 
+    function rejectQueued(error) {
+      while (queue.length)
+        queue.shift().reject(error)
+    }
+
     function handler(q) {
+      if (c.reserved !== reservation)
+        return q.reject(Errors.connection('CONNECTION_CLOSED', options))
+
       c.queue === full
         ? queue.push(q)
         : c.execute(q) || move(c, full)
@@ -238,12 +254,13 @@ function Postgres(a, b) {
     let savepoints = 0
       , connection
       , prepare = null
+      , closedError = null
 
     try {
       await sql.unsafe('begin ' + options.replace(/[^a-z ]/ig, ''), [], { onexecute }).execute()
       return await Promise.race([
         scope(connection, fn),
-        new Promise((_, reject) => connection.onclose = reject)
+        new Promise((_, reject) => connection.onclose = (error) => reject(closedError = error))
       ])
     } catch (error) {
       throw error
@@ -291,6 +308,12 @@ function Postgres(a, b) {
 
       function handler(q) {
         q.catch(e => uncaughtError || (uncaughtError = e))
+        // HeoPress patch: once the transaction's connection closed, its queries (the rollback that follows the
+        // failed query, or anything the callback still sends) are rejected instead of written to the socket that
+        // is gone (an uncaught TypeError in nextWrite) or to the connection the pool reconnected for someone else.
+        if (closedError)
+          return q.reject(closedError)
+
         c.queue === full
           ? queries.push(q)
           : c.execute(q) || move(c, full)
