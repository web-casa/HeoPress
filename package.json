{
  "name": "heopress",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "HeoPress - Edge-native Headless CMS (Turborepo monorepo)",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "node --max-old-space-size=6144 ./node_modules/eslint/bin/eslint.js --max-warnings 0 apps/cms/src apps/studio/src apps/site-classic/src apps/site-astro/src packages && turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @heopress/database generate",
    "db:drift:check": "pnpm --filter @heopress/database migrations:check",
    "deps:check": "depcruise apps/cms/src apps/studio/src apps/site-classic/src packages/sdk/src packages/extension-sdk/src packages/contracts/src packages/public-site/src --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --output-type err",
    "knip:check": "node scripts/check-knip.mjs",
    "knip:baseline": "node scripts/check-knip.mjs --update",
    "deps:baseline": "depcruise apps/cms/src apps/studio/src apps/site-classic/src packages/sdk/src packages/extension-sdk/src packages/contracts/src packages/public-site/src --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "db:migrate": "pnpm --filter @heopress/database migrate",
    "db:seed-dev": "pnpm --filter @heopress/database seed:dev",
    "db:studio": "pnpm --filter @heopress/database studio",
    "auth:reset-all": "pnpm --filter @heopress/auth dev:reset-all",
    "auth:create-user": "pnpm --filter @heopress/auth dev:create-user",
    "auth:reset-user": "pnpm --filter @heopress/auth dev:reset-user",
    "docs:i18n:detect": "node scripts/docs-i18n/sync.mjs",
    "docs:i18n:preserve": "node scripts/docs-i18n/sync.mjs --preserve-only",
    "docs:i18n:sync": "node scripts/docs-i18n/sync.mjs --apply",
    "docs:i18n:verify": "node scripts/docs-i18n/verify-code-refs.mjs",
    "docs:i18n:parity": "node scripts/docs-i18n/check-parity.mjs",
    "docs:i18n:stamp": "node scripts/docs-i18n/stamp-pair.mjs",
    "studio:dev": "pnpm --filter @heopress/studio dev",
    "cms:dev": "pnpm --filter @heopress/cms dev",
    "cms:deploy": "pnpm release:check && pnpm --filter @heopress/cms build:production && pnpm --filter @heopress/cms deploy:production",
    "heopress": "turbo run dev --filter=@heopress/studio --filter=@heopress/cms",
    "marketplace:dev": "pnpm --filter @heopress/marketplace dev",
    "marketplace:build": "pnpm --filter @heopress/marketplace build",
    "marketplace:preview": "pnpm --filter @heopress/marketplace start",
    "prepare": "husky",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "registry:check": "node scripts/check-registry-numbering.mjs",
    "verify:worker-bundle": "node scripts/check-worker-bundle.mjs",
    "verify:worker-startup": "node scripts/verify-worker-startup.mjs",
    "settings:check": "node scripts/check-pnpm-settings-parity.mjs",
    "drift:check": "node scripts/check-override-drift.mjs",
    "dist-tags:check": "node scripts/check-npm-dist-tags.mjs",
    "dist-tags:fix": "node scripts/check-npm-dist-tags.mjs --fix",
    "docs:cmd:check": "node scripts/check-docs-commands.mjs",
    "check:all": "pnpm notices:check && pnpm studio:i18n:check && pnpm removed-services:check && pnpm docs:check && pnpm docs:mcp-tools:check && pnpm skills:check && pnpm licenses:check && pnpm version:check && pnpm registry:check && pnpm settings:check && pnpm drift:check && pnpm db:drift:check && pnpm deps:check && pnpm knip:check && pnpm docs:cmd:check && pnpm docs:i18n:verify && pnpm scripts:test",
    "quality:fast": "node scripts/quality.mjs fast",
    "quality:pr": "node scripts/quality.mjs pr",
    "quality:release": "node scripts/quality.mjs release",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:mcp-tools": "node scripts/mcp-tool-reference.mjs",
    "docs:mcp-tools:check": "node scripts/mcp-tool-reference.mjs --check",
    "skills:check": "node scripts/check-skills.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "notices:check": "node scripts/check-modification-notices.mjs",
    "removed-services:check": "node scripts/check-removed-services.mjs",
    "studio:i18n:check": "node scripts/check-studio-i18n.mjs",
    "scripts:test": "node --test \"scripts/__tests__/*.test.mjs\"",
    "db:migrate:preflight": "pnpm --filter @heopress/database migrate:preflight",
    "db:migrate:dry-run": "pnpm --filter @heopress/database migrate:dry-run",
    "db:migrate:version": "pnpm --filter @heopress/database migrate:version"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "turbo": "^2.11.7",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "overrides": {
      "@graphql-tools/utils@11": "^12.0.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@5": "^5.0.8",
      "dompurify": "^3.4.17",
      "esbuild": "^0.28.2",
      "fast-uri": "4.1.5",
      "form-data": "^4.0.6",
      "ip-address": "^10.7.3",
      "js-yaml": "^4.3.2",
      "nanoid@3": "^3.3.17",
      "postcss": "^8.5.26",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "sharp": ">=0.35.5",
      "seroval": "^1.7.3",
      "seroval-plugins": "^1.7.3",
      "source-map-js": "^1.2.2",
      "undici": "^7.30.1",
      "uuid": "^14.0.1",
      "vite": "^8.3.2",
      "ws": "^8.22.0",
      "body-parser@2": "^2.4.0",
      "zod@4": "^4.6.6"
    },
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    }
  }
}
