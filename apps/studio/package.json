    "@hookform/resolvers": "^5.9.2",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-collaboration": "3.33.0",
    "@tiptap/extension-drag-handle": "3.33.0",
    "@tiptap/extension-drag-handle-react": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
