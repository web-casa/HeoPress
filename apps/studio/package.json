{
  "name": "@heopress/studio",
  "version": "1.3.0",
  "private": true,
  "description": "HeoPress Studio — no-code admin SPA (React + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node ../../scripts/with-build-metadata.mjs vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run",
    "clean": "rm -rf .turbo dist",
    "e2e": "playwright test",
    "visual": "playwright test -c playwright.visual.config.ts"
  },
  "dependencies": {
