{
  "name": "@heopress/cms",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "HeoPress CMS API — Hono.js on Cloudflare Workers.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "heopress": "./scripts/cli.ts"
  },
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "build": "node ../../scripts/with-build-metadata.mjs esbuild src/serve.ts --bundle --platform=node --format=cjs --outfile=dist/serve.cjs --external:pg-native --external:node-cron --external:sharp && node ../../scripts/with-build-metadata.mjs esbuild ../../packages/database/scripts/migrate.ts --bundle --platform=node --format=cjs --outfile=dist/migrate.cjs --external:pg-native --external:node-cron --external:sharp && node ../../scripts/with-build-metadata.mjs esbuild ../../packages/database/scripts/app-role.ts --bundle --platform=node --format=esm --outfile=dist/app-role.mjs && node ./scripts/copy-external-packages.mjs",
    "build:node": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "typegen": "tsx scripts/typegen.ts",
    "lint": "echo \"(lint not configured)\" && exit 0",
    "test": "vitest --run",
    "k6:login-brute": "k6 run k6/login-brute-force.js",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@heopress/ai-skills": "workspace:*",
    "@heopress/contracts": "workspace:*",
    "@heopress/database": "workspace:*",
    "@heopress/public-site": "workspace:*",
    "@heopress/runtime": "workspace:*",
    "@heopress/sdk": "workspace:*",
    "@heopress/seo-geo": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@mozilla/readability": "0.6.0",
    "drizzle-orm": "^0.45.3",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "linkedom": "0.18.12",
    "maxmind": "5.0.7",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "nodemailer": "10.0.14",
    "parse5": "8.0.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.0",
    "sanitize-html": "2.18.0",
    "uuid": "^14.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@heopress/site-classic": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.0",
    "fast-check": "^4.10.2",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^5.0.3"
  }
}
