exports[`extraction snapshots of ten recorded pages > 09-sidebar-comments.html 1`] = `
{
  "author": "Dr. Rita Patel",
  "bodyHtml": "<p>Keep a regular schedule: going to bed and waking up at the same time every day, weekends included, helps your body clock settle into a steady rhythm.</p><p>Make the bedroom dark, quiet and cool. Heavy curtains, earplugs or a fan can help, and most people sleep best at around eighteen degrees.</p><p>Limit screens in the hour before bed. Bright light in the evening delays the release of melatonin, the hormone that makes you feel sleepy.</p><p>Watch caffeine and alcohol. Coffee in the afternoon can still affect you at night, and alcohol fragments sleep in the second half of the night.</p><p>Get daylight and exercise during the day, ideally outdoors in the morning, which strengthens the signal that it is daytime.</p>",
  "bodyText": "Keep a regular schedule: going to bed and waking up at the same time every day, weekends included, helps your body clock settle into a steady rhythm.
Make the bedroom dark, quiet and cool. Heavy curtains, earplugs or a fan can help, and most people sleep best at around eighteen degrees.
Limit screens in the hour before bed. Bright light in the evening delays the release of melatonin, the hormone that makes you feel sleepy.
Watch caffeine and alcohol. Coffee in the afternoon can still affect you at night, and alcohol fragments sleep in the second half of the night.
Get daylight and exercise during the day, ideally outdoors in the morning, which strengthens the signal that it is daytime.",
  "canonicalCandidate": null,
  "hidden": [],
  "language": "en",
  "publishedAt": "2026-05-20T04:00:00.000Z",
  "title": "Five tips for better sleep",
}
`;

