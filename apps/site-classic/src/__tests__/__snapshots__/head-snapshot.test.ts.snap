            "https://social.example.com/head",
          ],
          "url": "https://head.example.com/",
        },
        {
          "@id": "https://head.example.com/#website",
          "@type": "WebSite",
          "inLanguage": "en",
          "name": "Head Site",
          "publisher": {
            "@id": "https://head.example.com/#identity",
          },
          "url": "https://head.example.com/",
        },
      ],
    },
  ],
  "meta": [
    {
      "content": "article",
      "property": "og:type",
    },
    {
      "content": "Hello <world> · Head Site",
      "property": "og:title",
    },
    {
      "content": "An excerpt & more.",
      "property": "og:description",
    },
    {
      "content": "Head Site",
      "property": "og:site_name",
    },
    {
      "content": "en",
      "property": "og:locale",
    },
    {
      "content": "https://head.example.com/media/hello.jpg",
      "property": "og:image",
    },
    {
      "content": "2026-10-01T08:00:00.000Z",
      "property": "article:published_time",
    },
    {
      "content": "2026-10-02T09:30:00.000Z",
      "property": "article:modified_time",
    },
    {
      "content": "summary_large_image",
      "name": "twitter:card",
    },
  ],
  "robots": "noindex",
  "title": "Hello <world> · Head Site",
}
`;

