<?xml version="1.0" encoding="UTF-8"?>
<!--
  HeoPress test schema for the Atom feeds this project writes (from the requirements in RFC 4287's text; not the RFC's
  RELAX NG schema): one id, title and updated per feed and entry, RFC 3339 dates, an author for the feed, absolute links.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:a="http://www.w3.org/2005/Atom"
           targetNamespace="http://www.w3.org/2005/Atom"
           elementFormDefault="qualified">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace" schemaLocation="xml.xsd"/>
  <xs:simpleType name="absolute"><xs:restriction base="xs:anyURI"><xs:pattern value="https?://[^\s]+"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="date"><xs:restriction base="xs:dateTime"><xs:pattern value=".*(Z|[+\-]\d{2}:\d{2})"/></xs:restriction></xs:simpleType>
  <xs:complexType name="person"><xs:sequence><xs:element name="name" type="xs:string"/></xs:sequence></xs:complexType>
  <xs:complexType name="text">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="type" use="optional">
          <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="text"/><xs:enumeration value="html"/></xs:restriction></xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:element name="link">
    <xs:complexType>
      <xs:attribute name="rel" type="xs:string" use="required"/>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="href" type="a:absolute" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="feed">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="a:absolute"/>
        <xs:element name="title" type="a:text"/>
        <xs:element name="subtitle" type="a:text" minOccurs="0"/>
        <xs:element name="updated" type="a:date"/>
        <xs:element name="author" type="a:person"/>
        <xs:element ref="a:link" maxOccurs="unbounded"/>
        <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="id" type="a:absolute"/>
              <xs:element name="title" type="a:text"/>
              <xs:element ref="a:link"/>
              <xs:element name="published" type="a:date" minOccurs="0"/>
              <xs:element name="updated" type="a:date"/>
              <xs:element name="author" type="a:person" minOccurs="0"/>
              <xs:element name="summary" type="a:text" minOccurs="0"/>
              <xs:element name="content" type="a:text"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute ref="xml:lang" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
