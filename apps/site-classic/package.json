{
  "name": "@heopress/site-classic",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "HeoPress classic rendering service: every public site from one process, reading the public projection as the read-only rendering role.",
  "type": "module",
  "main": "src/app.ts",
  "exports": {
    ".": "./src/app.ts",
    "./read-port": "./src/read-port.ts",
    "./cache": "./src/cache.ts",
    "./view-model": "./src/view-model.ts",
    "./ai-traffic": "./src/ai-traffic.ts"
  },
  "scripts": {
    "dev": "tsx watch src/serve.ts",
    "start": "tsx src/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "clean": "rm -rf .turbo dist",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@heopress/contracts": "workspace:*",
    "@heopress/database": "workspace:*",
    "@heopress/public-site": "workspace:*",
    "@heopress/seo-geo": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vitest": "^5.0.3",
    "xmllint-wasm": "5.3.0"
  }
}
