{
  "name": "@heopress/site-astro",
  "version": "1.0.0-rc.4",
  "private": true,
  "description": "HeoPress Astro engine: the static build template (page data from the read-only page data interface) and the build runner (isolated child process, atomic publication).",
  "type": "module",
  "main": "src/builder/index.ts",
  "exports": {
    ".": "./src/builder/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "clean": "rm -rf .turbo dist .astro",
    "build:site": "astro build"
  },
  "dependencies": {
    "@heopress/astro-kit": "workspace:*",
    "@heopress/contracts": "workspace:*",
    "astro": "7.4.5",
    "parse5": "8.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.6.2",
    "vitest": "^5.1.0",
    "@heopress/site-classic": "workspace:*"
  }
}
